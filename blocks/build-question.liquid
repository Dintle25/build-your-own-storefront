{% if block.settings.faq_entry != blank %}
  <div class="build-question">
    <h3 class="build-question__q">{{ block.settings.faq_entry.question.value }}</h3>
    <div class="build-question__a">{{ block.settings.faq_entry.answer.value | metafield_tag }}</div>
  </div>
{% endif %}

{% stylesheet %}
  .build-question__q {
    margin-block-end: 4px;
    font-size: 1rem;
  }

  .build-question__a {
    font-size: 0.9rem;
    opacity: 0.85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.build_question",
  "settings": [
    {
      "type": "metaobject",
      "id": "faq_entry",
      "metaobject_type": "build_faq",
      "label": "t:settings.faq_entry"
    }
  ],
  "presets": [
    {
      "name": "t:names.build_question"
    }
  ]
}
{% endschema %}